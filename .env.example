# Environment variables apply to the workstation-side backend.
# The SSH connection itself is configured using the Connect via SSH dialog.
# Plex token is automatically read from remote Preferences.xml, when permitted.
# PLEX_TOKEN=''
# TMDB_READ_TOKEN=''
# For local Plex operation only, instead of SSH:
# PLEX_DB='/var/lib/plexmediaserver/Library/Application Support/Plex Media Server/Plug-in Support/Databases/com.plexapp.plugins.library.db'
# PLEX_URL='http://127.0.0.1:32400'
# MEDIA_ROOTS='/media/Movies:/media/Series'
